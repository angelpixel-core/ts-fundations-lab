{
  "name": "ts-algo-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de entrevistas tecnicas con TypeScript: estructuras de datos, algoritmos y tipos avanzados.",
  "scripts": {
    "pipeline": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
